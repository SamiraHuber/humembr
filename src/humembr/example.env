# Copy this file to src/humembr/.env and fill in the absolute paths for your setup.

# Absolute path to the HumEmBr config file
HUMEMBR_CONFIG_PATH="/absolute/path/to/src/humembr/config.toml"

# PostgreSQL connection URL used by the application
DATABASE_URL="postgresql://postgres:mysecretpassword@localhost:5434/spot-db?sslmode=disable&connect_timeout=5"

# API key for the captioning / LLM backend (set if required by your provider)
# GEMINI_API_KEY="your-key-here"
